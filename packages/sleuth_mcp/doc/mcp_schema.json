{
  "_doc": "Wire schema for the ext.sleuth.* VM service extensions. test/validation/mcp_schema_audit_test.dart parses this file. doc/mcp_schema.md is the readable copy.",
  "schemaVersion": 1,
  "envelope": {
    "ok": {
      "connectionMode": {
        "type": "String",
        "required": true,
        "nullable": false,
        "values": ["disconnected", "warmup", "basic", "full", "correlated"]
      },
      "schemaVersion": {"type": "int", "required": true, "nullable": false, "value": 1},
      "sessionUuid": {"type": "String", "required": true, "nullable": false},
      "data": {"type": "Map<String, Object?>", "required": true, "nullable": false}
    },
    "error": {
      "connectionMode": {
        "type": "String",
        "required": true,
        "nullable": false,
        "values": ["disconnected", "warmup", "basic", "full", "correlated"]
      },
      "schemaVersion": {"type": "int", "required": true, "nullable": false, "value": 1},
      "sessionUuid": {"type": "String", "required": true, "nullable": false},
      "error": {"type": "String", "required": true, "nullable": false},
      "stack": {"type": "String", "required": false, "nullable": false}
    }
  },
  "handlers": {
    "ext.sleuth.diagnose": {
      "args": {},
      "data": {
        "packageVersion": {"type": "String", "required": true, "nullable": false},
        "initializedAtMicros": {"type": "int", "required": true, "nullable": true},
        "vmConnected": {"type": "bool", "required": true, "nullable": false},
        "captureMode": {"type": "bool", "required": true, "nullable": false},
        "lastCaptureExportFailure": {"type": "String", "required": true, "nullable": true},
        "unboundExtensionNames": {"type": "List<String>", "required": true, "nullable": false},
        "effectiveFrameRateHz": {"type": "num", "required": true, "nullable": false},
        "frameBudgetUs": {"type": "int", "required": true, "nullable": false},
        "frameRateSource": {"type": "String", "required": true, "nullable": false, "values": ["fixed", "display", "measured"]},
        "lastPollRpcMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollDecodeMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollParseMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollDispatchMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollDispatchDetectorsMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollDispatchCorrelateMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollDispatchAggregateMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollDispatchOtherMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollTailMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollTailMemoryMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollTailCpuSamplesMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollTailAllocationProfileMicros": {"type": "int", "required": true, "nullable": true},
        "lastPollEventCount": {"type": "int", "required": true, "nullable": true},
        "lastPollResponseChars": {"type": "int", "required": true, "nullable": true},
        "maxPollRpcMicros": {"type": "int", "required": true, "nullable": true},
        "maxPollDecodeMicros": {"type": "int", "required": true, "nullable": true},
        "maxPollParseMicros": {"type": "int", "required": true, "nullable": true},
        "maxPollDispatchMicros": {"type": "int", "required": true, "nullable": true},
        "pollDuplicatesDropped": {"type": "int", "required": true, "nullable": true},
        "pollWindowFallbacks": {"type": "int", "required": true, "nullable": true}
      }
    },
    "ext.sleuth.snapshot": {
      "args": {
        "sections": {"type": "String", "required": false, "nullable": false, "doc": "Comma-separated SnapshotSection keys, matched without regard to case or surrounding whitespace. Only the listed payload sections serialize. Metadata keys always serialize. Omit it for the full payload. An unknown name returns arg_invalid_section."},
        "maxIssueCount": {"type": "String (int)", "required": false, "nullable": false, "doc": "Keeps the top N already-ranked currentIssues. It takes a non-negative integer. A negative or non-numeric value returns arg_invalid_int. Setting it while sections leaves out currentIssues returns arg_pagination_unused."},
        "maxRouteCount": {"type": "String (int)", "required": false, "nullable": false, "doc": "Keeps the N most recent routeSessions by startedAt. It takes a non-negative integer. A negative or non-numeric value returns arg_invalid_int. Setting it while sections leaves out routeSessions returns arg_pagination_unused."}
      },
      "errors": ["arg_invalid_section", "arg_invalid_int", "arg_pagination_unused"],
      "data": {
        "_shape_source": "SessionSnapshot.toJson() in lib/src/models/session_snapshot.dart",
        "_projection_note": "When any projection arg is set, a payload field is present only if its SnapshotSection is in _projectedSections. Metadata keys (schemaVersion, exportedAt, packageVersion, isVmConnected, isDebugMode, suppressedCount) always serialize.",
        "_projectedSections": {"type": "List<String>", "required": false, "nullable": false, "presence": "when any projection arg (sections, maxIssueCount or maxRouteCount) was set; holds the SnapshotSection keys in this payload, sorted alphabetically"},
        "_projectionLimits": {"type": "Map", "required": false, "nullable": false, "presence": "when maxIssueCount or maxRouteCount was set", "shape": {"maxIssueCount": {"type": "int", "required": false, "nullable": false}, "maxRouteCount": {"type": "int", "required": false, "nullable": false}}},
        "_projectionApplied": {"type": "String", "required": false, "nullable": false, "presence": "when any projection arg was set", "values": ["by_app", "by_sidecar_fallback"]},
        "schemaVersion": {"type": "int", "required": true, "nullable": false},
        "exportedAt": {"type": "String (ISO-8601)", "required": true, "nullable": false},
        "packageVersion": {"type": "String", "required": true, "nullable": false},
        "isVmConnected": {"type": "bool", "required": true, "nullable": false},
        "isDebugMode": {"type": "bool", "required": true, "nullable": false},
        "frameStatsSummary": {"type": "Map<String, Object?>", "required": true, "nullable": false, "presence": "always, unless sections leaves it out"},
        "capturedFrames": {"type": "List<Map>", "required": true, "nullable": false, "presence": "always, unless sections leaves it out"},
        "currentIssues": {"type": "List<Map>", "required": true, "nullable": false, "presence": "always, unless sections leaves it out"},
        "suppressedCount": {"type": "int", "required": false, "nullable": false, "presence": "only when above 0"},
        "recentRequests": {"type": "List<Map>", "required": false, "nullable": false, "presence": "when NetworkMonitorDetector is enabled and the request ring buffer is non-empty"},
        "heapSamples": {"type": "List<Map>", "required": false, "nullable": false, "presence": "when MemoryPressureDetector has at least one sample buffered"},
        "phaseEvents": {"type": "List<Map>", "required": false, "nullable": false, "presence": "when the controller's rolling timeline-event buffer is non-empty"},
        "gcEvents": {"type": "List<Map>", "required": false, "nullable": false, "presence": "when Sleuth has seen GC events on the timeline stream"},
        "platformChannelEvents": {"type": "List<Map>", "required": false, "nullable": false, "presence": "when Sleuth has seen platform-channel events on the timeline stream"},
        "recentFrames": {"type": "List<Map>", "required": false, "nullable": false, "presence": "when the frame-stats buffer is non-empty"},
        "widgetHeatMap": {"type": "List<Map>", "required": false, "nullable": false, "opaque": true, "presence": "when at least one issue is ranked (Sleuth builds the heat map from ranked issues)", "_opaque_reason": "The item shape stays undocumented until a sidecar consumer relies on its keys."},
        "recurrenceTrends": {
          "type": "Map<String, Map>",
          "required": false,
          "nullable": false,
          "presence": "when not empty",
          "value_shape": {
            "trend": {"type": "String", "required": true, "nullable": false, "values": ["stable", "worsening", "improving", "intermittent"]},
            "totalOccurrences": {"type": "int", "required": true, "nullable": false},
            "totalObserved": {"type": "int", "required": true, "nullable": false},
            "lastSeenCycle": {"type": "int", "required": true, "nullable": true},
            "severityStats": {
              "type": "Map",
              "required": false,
              "nullable": false,
              "presence": "when the trend has at least one present observation",
              "shape": {
                "min": {"type": "int", "required": true, "nullable": false},
                "max": {"type": "int", "required": true, "nullable": false}
              }
            }
          }
        },
        "sessionSummary": {
          "type": "Map",
          "required": false,
          "nullable": false,
          "presence": "when at least one of its keys is present (an issue is ranked, the frame-stats buffer is non-empty, or at least two heap samples are buffered); every key inside is conditional",
          "shape": {
            "topIssues": {
              "type": "List<Map>",
              "required": false,
              "nullable": false,
              "presence": "when at least one issue is ranked; the top 5 ranked issues",
              "item_shape": {
                "stableId": {"type": "String", "required": true, "nullable": true, "doc": "null for an issue without a stableId (custom detectors)"},
                "title": {"type": "String", "required": true, "nullable": false},
                "severity": {"type": "String", "required": true, "nullable": false, "values": ["ok", "warning", "critical"]},
                "confidence": {"type": "String", "required": true, "nullable": false, "values": ["confirmed", "likely", "possible"]},
                "confidenceReason": {"type": "String", "required": false, "nullable": false, "presence": "when the issue has a confidence reason"},
                "rankingScore": {"type": "int", "required": true, "nullable": false},
                "widgetName": {"type": "String", "required": false, "nullable": false, "presence": "when the issue names a widget"}
              }
            },
            "frameHistogram": {
              "type": "Map<String, int>",
              "required": false,
              "nullable": false,
              "presence": "when the frame-stats buffer is non-empty (same condition as recentFrames); all five buckets are always present",
              "buckets": ["<16ms", "16-33ms", "33-50ms", "50-100ms", ">100ms"]
            },
            "detectorHitRates": {"type": "Map<String, int>", "required": false, "nullable": false, "presence": "when at least one issue is ranked (same condition as topIssues); counts every ranked issue by detector name"},
            "memoryTrendSummary": {
              "type": "Map",
              "required": false,
              "nullable": false,
              "presence": "when MemoryPressureDetector has at least two heap samples buffered",
              "shape": {
                "startBytes": {"type": "int", "required": true, "nullable": false},
                "endBytes": {"type": "int", "required": true, "nullable": false},
                "peakBytes": {"type": "int", "required": true, "nullable": false},
                "growthRatePerSec": {"type": "num", "required": true, "nullable": false},
                "sampleCount": {"type": "int", "required": true, "nullable": false}
              }
            },
            "causalEdges": {
              "type": "List<Map>",
              "required": false,
              "nullable": false,
              "presence": "when at least two issues are ranked and CausalGraphRule.activeEdges finds at least one edge between them",
              "item_shape": {
                "cause": {"type": "String", "required": true, "nullable": false},
                "effect": {"type": "String", "required": true, "nullable": false}
              }
            }
          }
        },
        "startupMetrics": {"type": "Map<String, Object?>", "required": false, "nullable": false, "presence": "when Sleuth.init captured first-frame data"},
        "routeSessions": {
          "type": "List<Map>",
          "required": false,
          "nullable": false,
          "presence": "when the route history is not empty",
          "item_shape": {
            "routeName": {"type": "String", "required": true, "nullable": false},
            "scaffoldHashKey": {"type": "int", "required": false, "nullable": false, "presence": "when Sleuth created the session from an Element subtree with a visible Scaffold; real-device captures always have it, and overlay sessions without a Scaffold do not"},
            "tabVisitIndex": {"type": "int", "required": true, "nullable": false},
            "hotReloadGeneration": {"type": "int", "required": false, "nullable": false, "presence": "only when above 0, that is, when Sleuth created the session after at least one hot reload"},
            "startedAt": {"type": "String (ISO-8601)", "required": true, "nullable": false},
            "endedAt": {"type": "String (ISO-8601)", "required": false, "nullable": false, "presence": "once the session is closed"},
            "healthScore": {"type": "num", "required": true, "nullable": false},
            "durationSeconds": {"type": "num", "required": true, "nullable": false},
            "scanCycles": {"type": "int", "required": true, "nullable": false},
            "frameStats": {
              "type": "Map",
              "required": true,
              "nullable": false,
              "shape": {
                "totalFrames": {"type": "int", "required": true, "nullable": false},
                "jankFrames": {"type": "int", "required": true, "nullable": false},
                "averageFps": {"type": "num", "required": true, "nullable": false},
                "p50": {"type": "num", "required": false, "nullable": false, "presence": "when frameStats.length >= 2"},
                "p95": {"type": "num", "required": false, "nullable": false, "presence": "when frameStats.length >= 2"},
                "p99": {"type": "num", "required": false, "nullable": false, "presence": "when frameStats.length >= 2"}
              }
            },
            "issueCount": {"type": "int", "required": true, "nullable": false, "doc": "Distinct issue keys the session retains, at most 256. The session evicts the oldest-inserted key first, so a longer session undercounts."},
            "criticalCount": {"type": "int", "required": true, "nullable": false, "doc": "Critical issues among the retained keys (see issueCount)."},
            "warningCount": {"type": "int", "required": true, "nullable": false, "doc": "Warning issues among the retained keys (see issueCount)."},
            "issues": {"type": "List<String>", "required": true, "nullable": false, "item_shape": "stableId", "doc": "The retained keys (stableId, else the issue title) in first-seen order, at most 256."},
            "rebuildCountsByType": {"type": "Map<String, int>", "required": false, "nullable": false, "presence": "when RebuildDetector accumulated per-type counts during the session", "doc": "At most 256 widget types. The session evicts the oldest-inserted type first."},
            "totalRebuilds": {"type": "int", "required": false, "nullable": false, "presence": "when RebuildDetector accumulated per-type counts during the session", "doc": "Sums the retained rebuildCountsByType entries only. It does not count rebuilds of evicted types."}
          }
        }
      }
    },
    "ext.sleuth.issues": {
      "args": {
        "route": {"type": "String", "required": false, "nullable": false, "doc": "An empty string counts as absent."}
      },
      "data": {
        "issues": {"type": "List<Map>", "required": true, "nullable": false, "item_shape": "PerformanceIssue.toJson()"},
        "route": {"type": "String", "required": false, "nullable": false, "presence": "only when the route arg was non-empty"},
        "vmConnected": {"type": "bool", "required": true, "nullable": false, "doc": "The same flag as ext.sleuth.diagnose data.vmConnected. It tells a VM-connected basic session from one without a VM link."}
      }
    },
    "ext.sleuth.routeHealth": {
      "args": {
        "route": {"type": "String", "required": false, "nullable": false, "doc": "An empty string counts as absent."}
      },
      "data": {
        "_shape_source": "RouteSession.toJson() in lib/src/models/route_session.dart. The item shape matches snapshot.routeSessions[] above.",
        "routes": {"type": "List<Map>", "required": false, "nullable": false, "presence": "only when the route arg is absent", "item_shape": "see ext.sleuth.snapshot.data.routeSessions item_shape"},
        "route": {"type": "Map<String, Object?>", "required": false, "nullable": false, "presence": "only when the route arg matches a session", "value_shape": "see ext.sleuth.snapshot.data.routeSessions item_shape"}
      },
      "errors": [
        {"error": "unknown_route", "extra": {"route": "String, the route arg as passed"}}
      ]
    },
    "ext.sleuth.explain": {
      "args": {
        "stableId": {"type": "String", "required": true, "nullable": false, "minLength": 1}
      },
      "data": {
        "stableId": {"type": "String", "required": true, "nullable": false},
        "canonical": {"type": "String", "required": true, "nullable": false},
        "explanation": {
          "type": "Map<String, Object?>",
          "required": true,
          "nullable": false,
          "shape": {
            "displayName": {"type": "String", "required": true, "nullable": false},
            "category": {"type": "String", "required": true, "nullable": false, "values": ["build", "layout", "paint", "raster", "memory", "channel", "font", "network", "startup"]},
            "whatItIs": {"type": "String", "required": true, "nullable": false},
            "readingTheData": {"type": "String", "required": true, "nullable": false},
            "whyItMatters": {"type": "String", "required": true, "nullable": false},
            "howToFix": {"type": "String", "required": true, "nullable": false},
            "whenToIgnore": {"type": "String", "required": true, "nullable": true, "doc": "null when the entry has no ignore guidance (for example heavy_compute)"},
            "relatedIssues": {"type": "List<String>", "required": true, "nullable": false}
          }
        }
      },
      "errors": [
        {"error": "missing_required_arg", "extra": {"arg": "stableId"}},
        {"error": "unknown_stable_id", "extra": {"stableId": "String", "canonical": "String"}}
      ]
    },
    "ext.sleuth.encyclopedia": {
      "args": {},
      "data": {
        "count": {"type": "int", "required": true, "nullable": false},
        "entries": {
          "type": "Map<String, Map>",
          "required": true,
          "nullable": false,
          "key": "canonical stableId",
          "value_shape": "same as ext.sleuth.explain.data.explanation"
        }
      }
    },
    "ext.sleuth.causalGraph": {
      "args": {},
      "data": {
        "count": {"type": "int", "required": true, "nullable": false},
        "rules": {
          "type": "List<Map>",
          "required": true,
          "nullable": false,
          "item_shape": {
            "trigger": {"type": "String", "required": true, "nullable": false},
            "effect": {"type": "String", "required": true, "nullable": false}
          }
        }
      }
    }
  },
  "notes": [
    "The envelope schemaVersion changes only on a breaking change: a rename, a removal or a type change. New optional fields and new handlers do not change it.",
    "The nested snapshot shapes (recurrenceTrends, sessionSummary, routeSessions) come from on-device captures in test/validation/captures/. doc/mcp_schema_derivation.md describes the procedure and the limits of the device context.",
    "The MCP tool-layer schema is in packages/sleuth_mcp/doc/mcp_tool_schema.{json,md} and ships only with the sidecar. packages/sleuth_mcp/test/schema/mcp_tool_schema_audit_test.dart audits it."
  ]
}
